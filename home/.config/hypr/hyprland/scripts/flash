#!/bin/bash

# HYPRLAND MIGRATION:
# hyprctl dispatch setprop active dim_around on
# hyprctl dispatch setprop active dim_around off
# Why: `dispatch` now takes a Lua dispatcher expression. `setprop` is exposed
#      as `hl.dsp.window.set_prop()`.

declare time_to_flash="0.5"

hyprctl dispatch \
    'hl.dsp.window.set_prop({ prop = "dim_around", value = "1" })' \
    >/dev/null

sleep "$time_to_flash"

hyprctl dispatch \
    'hl.dsp.window.set_prop({ prop = "dim_around", value = "0" })' \
    >/dev/null
