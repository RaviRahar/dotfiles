#!/bin/bash

# HYPRLAND MIGRATION:
# DEFAULT_PIGGYBACK_SETTING='input:touchpad:disable_while_typing'
# declare -i status=$(hyprctl getoption "$PIGGYBACK_SETTING" | head -n 1 | cut -d " " -f 2)
# hyprctl -r keyword '$touchpadStatus' $false
# hyprctl -r keyword '$touchpadStatus' $true
# Why: config option paths now use dots, and the old runtime `keyword`
#      interface / hyprlang variable mutation is gone. Change the actual Lua
#      config values and per-device `enabled` state instead.

DEFAULT_DEVICE_NAME='Touchpad'
DEFAULT_DEVICE='asue120d:00-04f3:31fb-touchpad'
DEFAULT_PIGGYBACK_SETTING='input.touchpad.disable_while_typing'

declare -r DEVICE_NAME=${1:-${DEFAULT_DEVICE_NAME}}
declare -r DEVICE=${2:-${DEFAULT_DEVICE}}
declare -r PIGGYBACK_SETTING=${3:-${DEFAULT_PIGGYBACK_SETTING}}
declare -r time_control_notifs=2000

status="$(hyprctl repl "hl.get_config([[$PIGGYBACK_SETTING]])")"

case "$status" in
true | 1)
    hyprctl eval "
            hl.config({
                input = {
                    touchpad = {
                        disable_while_typing = false
                    }
                }
            })
            hl.device({
                name = [[$DEVICE]],
                enabled = false
            })
        " >/dev/null

    notify-send -t "$time_control_notifs" \
        -h string:x-dunst-stack-tag:settings_notif \
        "${DEVICE_NAME} disabled"
    ;;
*)
    hyprctl eval "
            hl.config({
                input = {
                    touchpad = {
                        disable_while_typing = true
                    }
                }
            })
            hl.device({
                name = [[$DEVICE]],
                enabled = true
            })
        " >/dev/null

    notify-send -t "$time_control_notifs" \
        -h string:x-dunst-stack-tag:settings_notif \
        "${DEVICE_NAME} enabled"
    ;;
esac
